# Secrets
# Keep secret values empty in this tracked file.
# Put real values in .env.local.
OPENAI_API_KEY=
BORIS_CONTINUATION_SECRET=

# Runtime
BORIS_RUNTIME_MODE=dev
BORIS_CONTINUATION_TTL_SECONDS=3600
BOIS_LLM=openai
OPENAI_MODEL=gpt-4o
BORIS_CORE_PACKAGE=/opt/boris-core

# Optional semantic answer validation overrides.
# When omitted, validation uses BOIS_LLM and OPENAI_MODEL.
# BORIS_VALIDATOR_LLM=openai
# BORIS_VALIDATOR_MODEL=gpt-4o

# MCP
BORIS_RUNTIME_API_URL=http://127.0.0.1:8000
BORIS_MCP_TIMEOUT_SECONDS=30
BORIS_MCP_TRANSPORT=streamable-http
BORIS_MCP_HOST=127.0.0.1
BORIS_MCP_PORT=9000
BORIS_MCP_PATH=/mcp
BORIS_MCP_ALLOWED_HOSTS=boris.valerol.dev,boris.valerol.dev:*,127.0.0.1:*,localhost:*
BORIS_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Cache
HF_HOME=/opt/boris-runtime/.cache/huggingface
